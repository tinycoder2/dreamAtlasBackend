# Google Health / Fit OAuth 2.0 Credentials (Required)
GOOGLE_HEALTH_CLIENT_ID=your-google-health-client-id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your-google-health-client-secret

# Optional Overrides (defaults shown in application.properties)
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_DATABASE_ID=(default)
# GOOGLE_CLOUD_BIGQUERY_DATASET=dream_atlas_health
# GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8080/api/health/google/callback
# APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
